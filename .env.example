# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare Pages / Server Environment Variables
# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY="YOUR_MIDTRANS_SERVER_KEY_HERE"
MIDTRANS_CLIENT_KEY="YOUR_MIDTRANS_CLIENT_KEY_HERE"
MIDTRANS_IS_PRODUCTION="false"

# Biteship Logistics Aggregator API Key
BITESHIP_API_KEY="YOUR_BITESHIP_API_KEY_HERE"

# Firebase Realtime Database (legacy)
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
FIREBASE_DATABASE_URL="https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# Vite Environment Variables (exposed to client-side code, prefix VITE_ wajib)
# Isi nilai ini di Dashboard Cloudflare Pages → Settings → Environment variables
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

